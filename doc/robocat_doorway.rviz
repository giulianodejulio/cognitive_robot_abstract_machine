Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 39; 45
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 24
      Color: 95; 100; 110
      Alpha: 0.4
      Reference Frame: base_footprint
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robocat - transparent
      Enabled: true
      Alpha: 0.5
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Links:
        All Links Enabled: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Real lidar
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 0; 240; 240
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: elevator_doorway
      Enabled: true
      Reference Frame: elevator_doorway
      Length: 0.35
      Radius: 0.015
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: base_footprint
      Enabled: true
      Reference Frame: base_footprint
      Length: 0.30
      Radius: 0.012
      Value: true
    - Class: rviz_default_plugins/Axes
      Name: odom
      Enabled: true
      Reference Frame: odom
      Length: 0.40
      Radius: 0.015
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_footprint
      Distance: 3.2
      Pitch: 0.95
      Yaw: 4.712389
      Focal Point:
        X: 0.55
        Y: 0
        Z: 0.25
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1320
  Height: 900
  X: 40
  Y: 40
