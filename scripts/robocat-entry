#!/usr/bin/env bash
# %% isolated entry environment
set -eo pipefail
repository=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source /opt/ros/overlay_ws/install/setup.bash
export ROS_DOMAIN_ID=103 RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI="file://$repository/doc/robocat_cyclonedds.xml"
export PYTHONPATH="$repository:${PYTHONPATH:-}"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
cd "$repository"
exec 9>/tmp/robocat-entry.lock
flock -n 9 || { printf 'Another Robocat entry request is active\n' >&2; exit 1; }
exec /opt/ros/cram-env/bin/python -u -m experiments.robocat_snm "$@" \
    2> >(sed -u -f "$repository/experiments/src/experiments/robocat_snm/preparation_log.sed" >&2)
